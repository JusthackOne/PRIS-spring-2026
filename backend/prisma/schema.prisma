generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum IncidentType {
  ACCIDENT
  ROAD_WORK
  UTILITY
  SAFETY
  OTHER
}

enum IncidentStatus {
  ACTIVE
  IN_PROGRESS
  RESOLVED
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TransportType {
  BUS
  TRAM
  TROLLEYBUS
}

enum VehicleStatus {
  ACTIVE
  STOPPED
  OUT_OF_SERVICE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reports      Report[]
}

model Incident {
  id          String         @id @default(uuid())
  title       String
  description String
  type        IncidentType
  status      IncidentStatus @default(ACTIVE)
  latitude    Float
  longitude   Float
  address     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type, status])
}

model Report {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  title       String
  description String
  category    IncidentType
  status      ReportStatus @default(OPEN)
  latitude    Float
  longitude   Float
  address     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model Route {
  id         String        @id @default(uuid())
  name       String
  type       TransportType
  startPoint String
  endPoint   String
  vehicles   Vehicle[]
}

model Vehicle {
  id        String        @id @default(uuid())
  routeId   String
  route     Route         @relation(fields: [routeId], references: [id], onDelete: Restrict)
  number    String        @unique
  latitude  Float
  longitude Float
  speed     Float
  status    VehicleStatus @default(ACTIVE)
  updatedAt DateTime      @updatedAt

  @@index([routeId])
}
